# Copy this file to ".env" for local overrides. NEVER commit the real .env file.
# All values below are placeholders.

# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# True for local development, False for production.
DJANGO_DEBUG=True

# Comma-separated host names that may serve the site.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed for HTTPS deployments, e.g. https://students.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional. Defaults to Asia/Kolkata.
DJANGO_TIME_ZONE=Asia/Kolkata
